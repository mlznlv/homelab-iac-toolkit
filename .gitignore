# OpenTofu working data and sensitive outputs
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log

# Variable files hold environment-specific values; commit the examples instead.
# The provider lock file (.terraform.lock.hcl) is deliberately not ignored.
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Local environment and secret material
.env
.env.*
!.env.example
!.env.*.example
*.decrypted
*.decrypted.*
*.secret
*.secrets

# Key material. age and SSH private keys decrypt everything else, so they live
# outside this repository entirely; only the SOPS-encrypted form is committed.
# Public certificates share the .pem suffix; commit those as .pem.example.
*.key
*.pem
*.p12
*.pfx
*.agekey
*.age-key
id_rsa
id_dsa
id_ecdsa
id_ed25519
# Default identity filenames of age-keygen and SOPS_AGE_KEY_FILE.
key.txt
keys.txt

# Private deployment data. The leading **/ matches these directories at any
# depth, because a pattern containing a slash is otherwise anchored to the
# repository root while the write-time hook matches them anywhere.
**/inventory/private/
**/inventories/private/

# Ansible working data and the plaintext secret convention. These names denote
# the plaintext form wherever they appear, including group_vars and host_vars,
# so a committed SOPS-encrypted file carries a different name.
*.retry
.ansible/
secrets.yml
secrets.yaml

# Task runner state
.task/

# Claude Code personal overrides. The shared project configuration in
# .claude/ (settings.json, hooks, agents) is committed.
.claude/settings.local.json

# Editor, operating-system and language tooling files
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/
.venv/
