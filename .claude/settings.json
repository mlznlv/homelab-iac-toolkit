{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(markdownlint-cli2:*)",
      "Bash(lychee:*)",
      "Bash(yamllint:*)",
      "Bash(check-jsonschema:*)",
      "Bash(actionlint:*)",
      "Bash(zizmor:*)",
      "Bash(gitleaks:*)",
      "Bash(scripts/check-publication-safety-patterns.sh)",
      "Bash(tofu validate:*)",
      "Bash(tofu fmt -check:*)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(task --list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-unsafe-writes.sh",
            "statusMessage": "Checking publish-safety"
          }
        ]
      }
    ]
  }
}
