{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(ansible-lint:*)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(yamllint:*)",
      "Bash(markdownlint-cli2:*)",
      "Bash(task --list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-unsafe-writes.sh",
            "statusMessage": "Checking publish-safety"
          }
        ]
      }
    ]
  }
}
